# DATABASE_URL: pooled connection (Neon '-pooler' host) — used at runtime on serverless.
# DIRECT_URL: direct connection — used by migrations. Locally both can be the same value.
DATABASE_URL="postgresql://user:pass@host/db"
DIRECT_URL="postgresql://user:pass@host/db"
SESSION_SECRET="change-me-32-chars-minimum-secret!!"
ADMIN_EMAIL="owner@sarthakarts.com"
ADMIN_PASSWORD="change-me"
CONSULTANT_EMAIL="consultant@sarthakarts.com"
CONSULTANT_PASSWORD="change-me"
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="whsec_local_dev"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RESEND_API_KEY=""

# Storage: local disk for dev; set STORAGE_DRIVER=s3 in production (Cloudflare R2 or Amazon S3)
STORAGE_DIR=".storage"
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_ENDPOINT=""          # set for Cloudflare R2 (e.g. https://<account>.r2.cloudflarestorage.com); leave blank for AWS S3
S3_REGION="auto"        # "auto" for R2; the AWS region for S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

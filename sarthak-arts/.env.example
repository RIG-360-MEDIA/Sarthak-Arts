# DATABASE_URL: pooled connection (Neon '-pooler' host) — used at runtime on serverless.
# DIRECT_URL: direct connection — used by migrations. Locally both can be the same value.
DATABASE_URL="postgresql://user:pass@host/db"
DIRECT_URL="postgresql://user:pass@host/db"
# ── Supabase (database host + Auth + file storage) ──────────────────────────
# Project Settings → API Keys. The secret key is server-only: never commit or expose it.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
# Public site address used in signup confirmation emails (optional locally)
NEXT_PUBLIC_SITE_URL=""
ADMIN_EMAIL="owner@sarthakarts.com"
ADMIN_PASSWORD="change-me"
CONSULTANT_EMAIL="consultant@sarthakarts.com"
CONSULTANT_PASSWORD="change-me"
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="whsec_local_dev"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."
RESEND_API_KEY=""

# ── Headless Shopify (optional) ─────────────────────────────────────────────
# Leave blank to run on the built-in backend. When both STORE_DOMAIN and the
# STOREFRONT_ACCESS_TOKEN are set, the Shopify integration turns on.
# See docs/SHOPIFY_SETUP.md for how to create the store, app, and token.
SHOPIFY_STORE_DOMAIN=""              # e.g. sarthak-arts.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""   # public Storefront API access token
SHOPIFY_API_VERSION="2025-01"        # optional; a recent stable quarter

# Storage: local disk for dev; set STORAGE_DRIVER=s3 in production (Cloudflare R2 or Amazon S3)
STORAGE_DIR=".storage"
STORAGE_DRIVER="local"
S3_BUCKET=""
S3_ENDPOINT=""          # set for Cloudflare R2 (e.g. https://<account>.r2.cloudflarestorage.com); leave blank for AWS S3
S3_REGION="auto"        # "auto" for R2; the AWS region for S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
